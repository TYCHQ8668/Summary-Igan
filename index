                    if (selectedMonth !== '全部') {
                        let candidates = regularMonths.filter(m => extractMonthAbbr(m) === selectedMonth);
                        if (selectedYear !== '全部') {
                            candidates = candidates.filter(m => extractYear(m) === selectedYear);
                        }
                        const matchedMonth = candidates[0];
                        const md = matchedMonth ? v.months[matchedMonth] : null;
                        if (md) {
                            calcCats.forEach(cat => {
                                const p = md[cat];
                                if (p) totalVal += rankType === 'rm' ? (p.rm || 0) : (p.liter || 0);
                            });
