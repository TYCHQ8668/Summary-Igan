                });

                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.aoa_to_sheet(exportData);

                const fixedCols = 3;
                const colWidths = [{ wch: 18 }, { wch: 20 }, { wch: 14 }];
                displayMonths.forEach(m => { exportCats.forEach(cat => { colWidths.push({ wch: 12 }); }); });
                ws['!cols'] = colWidths;

                const merges = [];
                let colOffset = fixedCols;
                displayMonths.forEach((m, idx) => {
                    if (exportCats.length > 1) {
                        merges.push({ s: { r: 0, c: colOffset }, e: { r: 0, c: colOffset + exportCats.length - 1 } });
                    }
                    colOffset += exportCats.length;
                });
                ws['!merges'] = merges;

                XLSX.utils.book_append_sheet(wb, ws, '收支总览');

                const now = new Date();
                const timestamp = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}_${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}`;
                const filename = `Summary_Report_${timestamp}.xlsx`;

                XLSX.writeFile(wb, filename);
                showToast(`已导出: ${filename}`, 'fa-file-excel');
            }

