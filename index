            function updatePieChart(vehicles, regularMonths) {
                const ctx = document.getElementById('pieChart');
                if (!ctx) return;
                const calcCats = selectedCategories;
                const catTotals = {};
                calcCats.forEach(cat => { catTotals[cat] = 0; });

                let monthsToUse = regularMonths;
                if (selectedMonth !== '全部') {
                    monthsToUse = regularMonths.filter(m => extractMonthAbbr(m) === selectedMonth);
                    if (selectedYear !== '全部') {
                        monthsToUse = monthsToUse.filter(m => extractYear(m) === selectedYear);
                    }
                } else if (selectedYear !== '全部') {
                    monthsToUse = regularMonths.filter(m => extractYear(m) === selectedYear);
                }

                vehicles.forEach(v => {
                    monthsToUse.forEach(m => {
                        const md = v.months[m];
                        if (!md) return;
                        calcCats.forEach(cat => {
                            const p = md[cat];
                            if (p) {
                                catTotals[cat] += pieType === 'rm' ? (p.rm || 0) : (p.liter || 0);
                            }
                        });
                    });
                });

                const labels = [];
                const data = [];
                const colors = [];
                calcCats.forEach((cat, i) => {
                    if (catTotals[cat] > 0) {
                        labels.push(cat);
                        data.push(parseFloat(catTotals[cat].toFixed(2)));
                        colors.push(PIE_COLORS[i % PIE_COLORS.length]);
                    }
                });

                if (pieChart) pieChart.destroy();

                if (data.length === 0) {
                    pieChart = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: ['暂无数据'],
                            datasets: [{
                                data: [1],
                                backgroundColor: ['#eef2f8'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: { enabled: false }
                            }
                        }
                    });
                    return;
                }

                pieChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: colors,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true,
                                    padding: 12,
                                    boxWidth: 10,
                                    font: { size: 10 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(ctx) {
                                        const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((ctx.parsed / total) * 100).toFixed(1) : '0.0';
                                        const value = pieType === 'rm' ? ('RM ' + fmtComma(ctx.parsed)) : (fmtComma(ctx.parsed) + ' L');
                                        return ctx.label + ': ' + value + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            }

