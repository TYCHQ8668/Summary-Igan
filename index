                let filtered = regular;
                if (summaryYear !== '全部') filtered = filtered.filter(m => extractYear(m) === summaryYear);
                if (summaryMonth !== '全部') filtered = filtered.filter(m => extractMonthAbbr(m) === summaryMonth);
                const displayMonths = summaryMonth === '全部'
                    ? [...filtered, ...(summaryYear !== '全部' ? excluded.filter(m => extractYear(m) === summaryYear) : excluded)]
                    : filtered;

                const filteredVehicles = getSummaryFilteredVehicles(summaryData.vehicles);

                if (!filteredVehicles.length || !displayMonths.length) {
                    showToast('当前筛选无数据可导出', 'fa-triangle-exclamation');
                    return;
                }

                const exportData = [];
                const exportCats = summaryCategories;

                const headerRow1 = ['车牌', '车型', '燃油'];
                displayMonths.forEach(m => {
                    headerRow1.push(m);
                    for (let i = 1; i < exportCats.length; i++) headerRow1.push('');
                });
                exportData.push(headerRow1);

                const headerRow2 = ['', '', ''];
                displayMonths.forEach(m => {
                    exportCats.forEach(cat => { headerRow2.push(cat); });
                });
                exportData.push(headerRow2);

                filteredVehicles.forEach(v => {
                    const row = [v.vehicle || '-', getTypeCombo(v), v.fuel || '-'];
