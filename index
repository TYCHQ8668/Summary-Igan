            function exportToExcel() {
                if (!cachedData || !cachedData.vehicles) {
                    showToast('暂无数据可导出', 'fa-triangle-exclamation');
                    return;
                }

                const allMonths = cachedData.months;
                const regular = allMonths.filter(m => !isExcludedMonth(m));
                const excluded = allMonths.filter(isExcludedMonth);

                let filtered = regular;
                if (selectedYear !== '全部') filtered = filtered.filter(m => extractYear(m) === selectedYear);
                if (selectedMonth !== '全部') filtered = filtered.filter(m => extractMonthAbbr(m) === selectedMonth);
                const displayMonths = selectedMonth === '全部'
                    ? [...filtered, ...(selectedYear !== '全部' ? excluded.filter(m => extractYear(m) === selectedYear) : excluded)]
                    : filtered;

                const filteredVehicles = getFilteredVehicles(cachedData.vehicles);

                if (!filteredVehicles.length || !displayMonths.length) {
                    showToast('当前筛选无数据可导出', 'fa-triangle-exclamation');
                    return;
                }

                const sortedVehicles = [...filteredVehicles].sort((a, b) => {
                    const typeA = getTypeCombo(a);
                    const typeB = getTypeCombo(b);
                    return typeA.localeCompare(typeB);
                });

                function getVal(v, m, cat, isRM) {
                    const md = v.months[m];
                    if (!md) return 0;
                    const p = md[cat];
                    if (!p) return 0;
                    return isRM ? (p.rm || 0) : (p.liter || 0);
                }

                const valueTypes = [];
                if (showRM) valueTypes.push({ key: 'rm', label: 'RM' });
                if (showLiter) valueTypes.push({ key: 'liter', label: 'Liter' });
                if (valueTypes.length === 0) valueTypes.push({ key: 'rm', label: 'RM' });

                const exportData = [];
                const exportCats = selectedCategories;

                const headerRow1 = ['车牌', '车型', '燃油'];
                const monthColSpans = [];
                displayMonths.forEach(m => {
                    let span = 0;
                    exportCats.forEach(cat => { span += valueTypes.length; });
                    monthColSpans.push(span);
                    headerRow1.push(m);
                    for (let i = 1; i < span; i++) headerRow1.push('');
                });
                exportData.push(headerRow1);

                const headerRow2 = ['', '', ''];
                displayMonths.forEach(m => {
                    exportCats.forEach(cat => {
                        for (let i = 0; i < valueTypes.length; i++) {
                            headerRow2.push(i === 0 ? cat : '');
                        }
                    });
                });
                exportData.push(headerRow2);

                const headerRow3 = ['', '', ''];
                displayMonths.forEach(m => {
                    exportCats.forEach(cat => {
                        valueTypes.forEach(vt => { headerRow3.push(vt.label); });
                    });
                });
                exportData.push(headerRow3);

                let lastType = null;
                let typeSubtotals = {};
                let categoryTotals = {};

                sortedVehicles.forEach(v => {
                    const type = getTypeCombo(v);

                    if (lastType !== null && type !== lastType) {
                        exportData.push(generateSubtotalRow('车型小计', lastType, displayMonths, typeSubtotals[lastType]));
                    }

                    const row = [v.vehicle || '-', type, v.fuel || '-'];
                    displayMonths.forEach(m => {
                        exportCats.forEach(cat => {
                            valueTypes.forEach(vt => {
                                row.push(getVal(v, m, cat, vt.key === 'rm'));
                            });
                        });
                    });
                    exportData.push(row);

                    if (!typeSubtotals[type]) {
                        typeSubtotals[type] = {};
                        displayMonths.forEach(m => {
                            typeSubtotals[type][m] = {};
                            exportCats.forEach(cat => { typeSubtotals[type][m][cat] = { rm: 0, liter: 0 }; });
                        });
                    }
                    displayMonths.forEach(m => {
                        exportCats.forEach(cat => {
                            typeSubtotals[type][m][cat].rm += getVal(v, m, cat, true);
                            typeSubtotals[type][m][cat].liter += getVal(v, m, cat, false);
                        });
                    });

                    exportCats.forEach(cat => {
                        if (!categoryTotals[cat]) categoryTotals[cat] = { rm: 0, liter: 0 };
                        displayMonths.forEach(m => {
                            categoryTotals[cat].rm += getVal(v, m, cat, true);
                            categoryTotals[cat].liter += getVal(v, m, cat, false);
                        });
                    });

                    lastType = type;
                });

                if (lastType !== null) {
                    exportData.push(generateSubtotalRow('车型小计', lastType, displayMonths, typeSubtotals[lastType]));
                }

                exportData.push([]);

                exportCats.forEach(cat => {
                    exportData.push(generateGrandRow(cat + ' 总计', displayMonths, cat, categoryTotals[cat]));
                });

                exportData.push([]);

                const allCatsTotal = { rm: 0, liter: 0 };
                exportCats.forEach(cat => {
                    if (categoryTotals[cat]) {
                        allCatsTotal.rm += categoryTotals[cat].rm;
                        allCatsTotal.liter += categoryTotals[cat].liter;
                    }
                });
                exportData.push(generateGrandRow('所有类别总计', displayMonths, null, allCatsTotal));

                function generateSubtotalRow(label, type, months, subtotalData) {
                    const row = [label, type || '', ''];
                    months.forEach(m => {
                        exportCats.forEach(cat => {
                            valueTypes.forEach(vt => {
                                const sd = subtotalData && subtotalData[m] && subtotalData[m][cat];
                                row.push(sd ? (vt.key === 'rm' ? sd.rm : sd.liter) : 0);
                            });
                        });
                    });
                    return row;
                }

                function generateGrandRow(label, months, cat, totalData) {
                    const row = [label, '', ''];
                    months.forEach(m => {
                        if (cat) {
                            valueTypes.forEach(vt => {
                                row.push(totalData ? (vt.key === 'rm' ? totalData.rm : totalData.liter) : 0);
                            });
                        } else {
                            exportCats.forEach(c => {
                                valueTypes.forEach(vt => {
                                    row.push(totalData ? (vt.key === 'rm' ? totalData.rm : totalData.liter) : 0);
                                });
                            });
                        }
                    });
                    return row;
                }

                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.aoa_to_sheet(exportData);

                const fixedCols = 3;
                const totalCols = fixedCols + displayMonths.reduce((sum, m) => sum + exportCats.length * valueTypes.length, 0);
                const totalRows = exportData.length;

                const colWidths = [
                    { wch: 18 }, { wch: 20 }, { wch: 14 }
                ];
                displayMonths.forEach(m => {
                    exportCats.forEach(cat => {
                        valueTypes.forEach(vt => { colWidths.push({ wch: 14 }); });
                    });
                });
                ws['!cols'] = colWidths;

                const merges = [];
                let colOffset = fixedCols;
                displayMonths.forEach((m, idx) => {
                    const span = monthColSpans[idx];
                    if (span > 1) {
                        merges.push({ s: { r: 0, c: colOffset }, e: { r: 0, c: colOffset + span - 1 } });
                    }
                    let catCol = colOffset;
                    exportCats.forEach(cat => {
                        if (valueTypes.length > 1) {
                            merges.push({ s: { r: 1, c: catCol }, e: { r: 1, c: catCol + valueTypes.length - 1 } });
                        }
                        catCol += valueTypes.length;
                    });
                    colOffset += span;
                });
                ws['!merges'] = merges;

                ws['!freeze'] = { xSplit: fixedCols, ySplit: 3, topLeftCell: XLSX.utils.encode_cell({ r: 3, c: fixedCols }), activePane: 'bottomRight', state: 'frozen' };

                for (let r = 3; r < totalRows; r++) {
                    for (let c = fixedCols; c < totalCols; c++) {
                        const cellRef = XLSX.utils.encode_cell({ r: r, c: c });
                        if (ws[cellRef] && typeof ws[cellRef].v === 'number') {
                            ws[cellRef].z = '#,##0.00';
                        }
                    }
                }

                XLSX.utils.book_append_sheet(wb, ws, '燃油数据');

                const now = new Date();
                const timestamp = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}_${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}`;
                const filterInfo = [];
                if (selectedYear !== '全部') filterInfo.push(selectedYear);
                if (selectedMonth !== '全部') filterInfo.push(selectedMonth);
                if (selectedVehicles.length > 0) filterInfo.push(selectedVehicles.join('_'));
                else if (selectedTypes.length > 0) filterInfo.push(selectedTypes.join('_'));
                else if (selectedFuels.length > 0) filterInfo.push(selectedFuels.join('_'));
                const filterStr = filterInfo.length > 0 ? '_' + filterInfo.join('_') : '';
                const filename = `Fuel_Report${filterStr}_${timestamp}.xlsx`;

                XLSX.writeFile(wb, filename);
                showToast(`已导出: ${filename}`, 'fa-file-excel');
            }

            function render(data) {
