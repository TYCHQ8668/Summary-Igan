                    summaryTableBody.innerHTML =
                        `<tr><td colspan="10" class="empty-state"><i class="fa-solid fa-triangle-exclamation"></i> 数据格式错误</td></tr>`;
                    return;
                }
                const allMonths = summaryData.months;
                const regular = allMonths.filter(m => !isExcludedMonth(m));
                const excluded = allMonths.filter(isExcludedMonth);
                const years = [...new Set(regular.map(extractYear))].sort();
                const monthAbbrs = [...new Set(regular.map(extractMonthAbbr))].sort((a, b) => monthSortKey(a) - monthSortKey(
                    b));
                if (!summaryYearOptionsBuilt) {
                    summaryYearSelector.innerHTML = '<option value="全部">全部年份</option>';
                    years.forEach(y => summaryYearSelector.innerHTML += `<option value="${y}">${y}</option>`);
                    const cy = String(new Date().getFullYear());
                    summaryYearSelector.value = years.includes(cy) ? cy : (years[0] || '全部');
                    summaryYear = summaryYearSelector.value;
                    summaryYearOptionsBuilt = true;
                }
                let filtered = regular;
                if (summaryYear !== '全部') filtered = filtered.filter(m => extractYear(m) === summaryYear);
                if (summaryMonth !== '全部') filtered = filtered.filter(m => extractMonthAbbr(m) === summaryMonth);
                const display = summaryMonth === '全部' ? [...filtered, ...(summaryYear !== '全部' ? excluded.filter(m =>
                    extractYear(m) === summaryYear) : excluded)] : filtered;
                const allVehicles = summaryData.vehicles;
                const filteredVehicles = getSummaryFilteredVehicles(allVehicles);
                const currentVehicleCount = filteredVehicles.length;
                summaryStatVehicles.textContent = currentVehicleCount;
                summaryStatVehiclesSub.textContent = summaryVehicles.length > 0 ? `已选: ${summaryVehicles.length}辆` : (
                    summaryTypes.length > 0 ? `${summaryTypes.length}个车型` : (summaryFuels.length > 0 ?
                        `${summaryFuels.length}种燃油` : '点击选择车牌'));
                let totalExpense = 0,
                    totalRevenue = 0,
                    totalProfit = 0;
                filteredVehicles.forEach(v => {
                    filtered.forEach(m => {
                        totalExpense += getSummaryExpense(v, m);
                        totalRevenue += getSummaryRevenue(v, m);
                        totalProfit += getSummaryProfit(v, m);
                    });
                });
                summaryStatExpense.textContent = fmtComma(totalExpense);
                const isAllExpenseSelected = EXPENSE_CATEGORIES.every(cat => summaryCategories.includes(cat));
                summaryStatExpenseSub.textContent = isAllExpenseSelected ? '所有费用' :
                    `已选 ${summaryCategories.filter(c => EXPENSE_CATEGORIES.includes(c)).length}/${EXPENSE_CATEGORIES.length} 项费用`;
                summaryStatRevenue.textContent = fmtComma(totalRevenue);
                summaryStatProfit.textContent = fmtComma(totalProfit);
                updateSummaryTrendChart(filteredVehicles, regular);
                updateSummaryRankList(filteredVehicles, regular);
                updateSummaryRankToggleUI();
                updateSummaryPieChart(filteredVehicles, regular);
                updateSummaryLineToggleUI();
                if (summaryVehicleModalVisible && summaryData) renderSummaryVehicleModalList();
                if (summaryTypeModalVisible && summaryData) renderSummaryTypeModalList();
                if (summaryFuelModalVisible && summaryData) renderSummaryFuelModalList();
                if (summaryExpenseModalVisible) renderSummaryExpenseModalList();
                const showTableModeToggle = EXPENSE_CATEGORIES.every(cat => summaryCategories.includes(cat));
                let head =
                    `<tr class="filter-row"><td class="col-fixed" colspan="2"><span class="filter-label"><i class="fa-solid fa-calendar-alt"></i> 月份筛选</span><select class="month-selector" id="summaryMonthSelector"><option value="全部">全部月份</option>`;
                monthAbbrs.forEach(m => head += `<option value="${m}">${m}</option>`);
                head += `</select>`;
                if (showTableModeToggle) {
                    head +=
                        `<span class="table-mode-toggle"><button class="table-mode-btn ${summaryTableMode==='summary'?'active':''}" data-mode="summary">总额</button><button class="table-mode-btn ${summaryTableMode==='detail'?'active':''}" data-mode="detail">明细</button></span>`;
                }
                head += `</td>`;
                head +=
                    `<td colspan="${display.length+2}" style="background:#f8faff;"><span style="font-size:.75rem;color:#5e7390;"><i class="fa-solid fa-filter"></i> 共 ${filtered.length} 个月份</span></td></tr>`;
                head += `<tr>`;
                const fixedCols = ['vehicle', 'brand', 'type', 'fuel'];
                const fixedLabels = ['车牌', '品牌', '车型', '燃油'];
                fixedCols.forEach((col, i) => {
                    const cls = (col === 'vehicle') ? ' col-fixed' : '';
                    head += `<th class="${cls}">${fixedLabels[i]}</th>`;
                });
                display.forEach(m => {
                    const isSum = isExcludedMonth(m);
                    head +=
                        `<th class="col-month"><span style="background:${isSum?'#f0e6d0':'#eef4fd'};padding:2px 10px;border-radius:40px;font-size:.75rem;color:${isSum?'#8a6e3b':'#1f3a5e'};font-weight:${isSum?'700':'500'}">${m}</span></th>`;
                });
                head += `</tr>`;
                summaryTableHead.innerHTML = head;
                const summaryMonthSelector = document.getElementById('summaryMonthSelector');
                if (summaryMonthSelector) summaryMonthSelector.value = monthAbbrs.includes(summaryMonth) ? summaryMonth :
                    '全部';
                summaryTableHead.querySelectorAll('.table-mode-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        summaryTableMode = this.dataset.mode;
                        renderSummary();
                    });
                });
                let body = '';
                if (!filteredVehicles.length || !display.length) {
                    summaryTableBody.innerHTML =
                        `<tr><td colspan="${display.length+4}" class="empty-state"><i class="fa-solid fa-box-open"></i> 暂无数据</td></tr>`;
                    return;
                }
                filteredVehicles.forEach(v => {
                    body += `<tr>`;
                    body += `<td class="col-fixed"><div class="vehicle-cell">${v.vehicle||'-'}</div></td>`;
                    body += `<td>${v.brand||'-'}</td>`;
                    body += `<td>${v.type||'-'}</td>`;
                    body += `<td>${v.fuel||'-'}</td>`;
                    display.forEach(m => {
                        body += `<td class="col-month">`;
                        let effectiveMode = summaryTableMode;
                        if (!showTableModeToggle) {
                            effectiveMode = 'detail';
                        }
                        if (effectiveMode === 'summary') {
                            const expense = getSummaryExpense(v, m);
                            const revenue = getSummaryRevenue(v, m);
                            const profit = getSummaryProfit(v, m);
                            body +=
                                `<div class="summary-category-item"><span class="summary-cat-name">总费用</span><span class="summary-val expense">${fmtComma(expense)}</span></div>`;
                            body +=
                                `<div class="summary-category-item"><span class="summary-cat-name">总收入</span><span class="summary-val revenue">${fmtComma(revenue)}</span></div>`;
                            body +=
                                `<div class="summary-category-item"><span class="summary-cat-name">损益</span><span class="summary-val profit">${fmtComma(profit)}</span></div>`;
                        } else {
                            EXPENSE_CATEGORIES.forEach(cat => {
                                if (!summaryCategories.includes(cat)) return;
                                const val = getSummaryValue(v, m, cat);
                                body +=
                                    `<div class="summary-category-item"><span class="summary-cat-name">${cat}</span><span class="summary-val expense">${fmtComma(val)}</span></div>`;
                            });
                            if (summaryCategories.includes('Revenue')) {
                                const revenue = getSummaryRevenue(v, m);
                                body +=
                                    `<div class="summary-category-item"><span class="summary-cat-name">总收入</span><span class="summary-val revenue">${fmtComma(revenue)}</span></div>`;
                            }
                            if (summaryCategories.includes('Profit')) {
                                const profit = getSummaryProfit(v, m);
                                body +=
                                    `<div class="summary-category-item"><span class="summary-cat-name">损益</span><span class="summary-val profit">${fmtComma(profit)}</span></div>`;
                            }
                        }
                        body += `</td>`;
                    });
                    body += `</tr>`;
                });
                summaryTableBody.innerHTML = body;
            }

            function switchPage(page) {
                currentPage = page;
                if (page === 'fuel') {
                    fuelPage.style.display = '';
                    summaryPage.style.display = 'none';
                    fuelHeaderRight.style.display = '';
                    summaryHeaderRight.style.display = 'none';
                    navMenuLabel.textContent = 'Fuel Dashboard';
                    pageTitle.textContent = 'Fuel Dashboard';
                    navDropdown.querySelectorAll('.nav-dropdown-item').forEach(item => {
                        item.classList.toggle('active', item.dataset.page === 'fuel');
                    });
                } else {
                    fuelPage.style.display = 'none';
                    summaryPage.style.display = '';
                    fuelHeaderRight.style.display = 'none';
                    summaryHeaderRight.style.display = '';
                    navMenuLabel.textContent = 'Summary Report';
                    pageTitle.textContent = 'Summary Report';
                    navDropdown.querySelectorAll('.nav-dropdown-item').forEach(item => {
                        item.classList.toggle('active', item.dataset.page === 'summary');
                    });
                    renderSummary();
                }
                navDropdown.classList.remove('show');
                navMenuBtn.classList.remove('open');
            }

            function init() {
                const cache = getCache();
                updateCacheBadge(cache ? '缓存' : '无缓存', cache?.timestamp);
                loadData();
                refreshBtn.addEventListener('click', () => !isRefreshing && loadData(true));
                exportBtn.addEventListener('click', exportToExcel);
                resetBtn.addEventListener('click', resetAllFilters);
                toggleGroup.addEventListener('click', e => {
                    const btn = e.target.closest('.toggle-btn');
                    if (!btn) return;
                    if (btn.dataset.type === 'rm') showRM = showRM ? (showLiter ? false : true) : true;
                    else showLiter = showLiter ? (showRM ? false : true) : true;
                    updateToggle();
                    cachedData && render(cachedData);
                });
                yearSelector.addEventListener('change', e => { selectedYear = e.target.value;
                    cachedData && render(cachedData); });
                tableHead.addEventListener('change', e => { if (e.target.id === 'monthSelector') { selectedMonth = e
                        .target.value;
                        cachedData && render(cachedData); } });
                rankToggleGroup.addEventListener('click', e => {
                    const btn = e.target.closest('.rank-toggle-btn');
                    if (!btn) return;
                    if (btn.dataset.rtype === 'rm') rankType = 'rm';
                    else rankType = 'liter';
                    cachedData && render(cachedData);
                });
                pieToggleGroup.addEventListener('click', e => {
                    const btn = e.target.closest('.pie-toggle-btn');
                    if (!btn) return;
                    if (btn.dataset.ptype === 'rm') pieType = 'rm';
                    else pieType = 'liter';
                    cachedData && render(cachedData);
                });
                statCardVehicles.addEventListener('click', () => { if (!cachedData) return;
                    openVehicleModal(); });
                statCardTypes.addEventListener('click', () => { if (!cachedData) return;
                    openTypeModal(); });
                statCardFuels.addEventListener('click', () => { if (!cachedData) return;
                    openFuelModal(); });
                modalCloseVehicle.addEventListener('click', closeVehicleModal);
                vehicleModalOverlay.addEventListener('click', function(e) { if (e.target === vehicleModalOverlay)
                        closeVehicleModal(); });
                modalSearchVehicle.addEventListener('input', function() { vehicleSearchTerm = this.value;
                    renderVehicleModalList(); });
                modalClearVehicle.addEventListener('click', clearVehicleFilter);
                modalConfirmVehicle.addEventListener('click', applyVehicleFilter);
                modalCloseType.addEventListener('click', closeTypeModal);
                typeModalOverlay.addEventListener('click', function(e) { if (e.target === typeModalOverlay)
                        closeTypeModal(); });
                modalSearchType.addEventListener('input', function() { typeSearchTerm = this.value;
                    renderTypeModalList(); });
                modalClearType.addEventListener('click', clearTypeFilter);
                modalConfirmType.addEventListener('click', applyTypeFilter);
                modalCloseFuel.addEventListener('click', closeFuelModal);
                fuelModalOverlay.addEventListener('click', function(e) { if (e.target === fuelModalOverlay)
                        closeFuelModal(); });
                modalSearchFuel.addEventListener('input', function() { fuelSearchTerm = this.value;
                    renderFuelModalList(); });
                modalClearFuel.addEventListener('click', clearFuelFilter);
                modalConfirmFuel.addEventListener('click', applyFuelFilter);
                // Summary 事件
                summaryYearSelector.addEventListener('change', e => { summaryYear = e.target.value;
                    renderSummary(); });
                summaryTableHead.addEventListener('change', e => {
                    if (e.target.id === 'summaryMonthSelector') { summaryMonth = e.target.value;
                        renderSummary(); }
                });
                summaryResetBtn.addEventListener('click', resetSummaryFilters);
                summaryExportBtn.addEventListener('click', summaryExportToExcel);
                summaryLineToggle.addEventListener('click', e => {
                    const btn = e.target.closest('.summary-line-btn');
                    if (!btn) return;
                    const line = btn.dataset.line;
                    summaryLineShow[line] = !summaryLineShow[line];
                    if (!summaryLineShow.expense && !summaryLineShow.revenue && !summaryLineShow.profit) {
                        summaryLineShow[line] = true;
                    }
                    renderSummary();
                });
                summaryRankToggleGroup.addEventListener('click', e => {
                    const btn = e.target.closest('.rank-toggle-btn');
                    if (!btn) return;
                    summaryRankType = btn.dataset.srtype;
                    renderSummary();
                });
                summaryStatCardVehicles.addEventListener('click', () => { if (summaryData)
                        openSummaryVehicleModal(); });
                summaryStatCardExpense.addEventListener('click', () => { if (summaryData)
                        openSummaryExpenseModal(); });
                summaryModalCloseVehicle.addEventListener('click', closeSummaryVehicleModal);
                summaryVehicleModalOverlay.addEventListener('click', function(e) { if (e.target ===
                        summaryVehicleModalOverlay) closeSummaryVehicleModal(); });
                summaryModalSearchVehicle.addEventListener('input', function() { summaryVehicleSearchTerm = this.value;
                    renderSummaryVehicleModalList(); });
                summaryModalClearVehicle.addEventListener('click', clearSummaryVehicleFilter);
                summaryModalConfirmVehicle.addEventListener('click', applySummaryVehicleFilter);
                summaryModalCloseType.addEventListener('click', closeSummaryTypeModal);
                summaryTypeModalOverlay.addEventListener('click', function(e) { if (e.target === summaryTypeModalOverlay)
                        closeSummaryTypeModal(); });
                summaryModalSearchType.addEventListener('input', function() { summaryTypeSearchTerm = this.value;
                    renderSummaryTypeModalList(); });
                summaryModalClearType.addEventListener('click', clearSummaryTypeFilter);
                summaryModalConfirmType.addEventListener('click', applySummaryTypeFilter);
                summaryModalCloseFuel.addEventListener('click', closeSummaryFuelModal);
                summaryFuelModalOverlay.addEventListener('click', function(e) { if (e.target === summaryFuelModalOverlay)
                        closeSummaryFuelModal(); });
                summaryModalSearchFuel.addEventListener('input', function() { summaryFuelSearchTerm = this.value;
                    renderSummaryFuelModalList(); });
                summaryModalClearFuel.addEventListener('click', clearSummaryFuelFilter);
                summaryModalConfirmFuel.addEventListener('click', applySummaryFuelFilter);
                summaryModalCloseExpense.addEventListener('click', closeSummaryExpenseModal);
                summaryExpenseModalOverlay.addEventListener('click', function(e) { if (e.target ===
                        summaryExpenseModalOverlay) closeSummaryExpenseModal(); });
                summaryModalClearExpense.addEventListener('click', clearSummaryExpenseFilter);
                summaryModalConfirmExpense.addEventListener('click', applySummaryExpenseFilter);
                navMenuBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    navDropdown.classList.toggle('show');
                    navMenuBtn.classList.toggle('open');
                });
                navDropdown.querySelectorAll('.nav-dropdown-item').forEach(item => {
                    item.addEventListener('click', function() {
                        switchPage(this.dataset.page);
                    });
                });
                document.addEventListener('click', function(e) {
                    if (!navMenuBtn.contains(e.target) && !navDropdown.contains(e.target)) {
                        navDropdown.classList.remove('show');
                        navMenuBtn.classList.remove('open');
                    }
                });
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        navDropdown.classList.remove('show');
                        navMenuBtn.classList.remove('open');
                        if (vehicleModalVisible) closeVehicleModal();
                        if (typeModalVisible) closeTypeModal();
                        if (fuelModalVisible) closeFuelModal();
                        if (summaryVehicleModalVisible) closeSummaryVehicleModal();
                        if (summaryTypeModalVisible) closeSummaryTypeModal();
                        if (summaryFuelModalVisible) closeSummaryFuelModal();
                        if (summaryExpenseModalVisible) closeSummaryExpenseModal();
                    }
                });
            }
            init();
        })();
    </script>
</body>
</html>
