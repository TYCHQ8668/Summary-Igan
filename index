                allCats.forEach(cat => {
                    let active = false;
                    if (cat === '全部') active = isAll;
                    else active = !isAll && selectedCategories.includes(cat);
                    const cls = 'category-chip' + (cat === '全部' ? ' all-chip' : '') + (active ? ' active' :
                        '');
                    html +=
                        `<span class="${cls}" data-cat="${cat.replace(/"/g,'&quot;')}">${cat==='全部'?'全部':cat}</span>`;
                });
                wrap.innerHTML = html;
                wrap.querySelectorAll('.category-chip').forEach(chip => {
                    chip.addEventListener('click', function() {
                        const cat = this.dataset.cat;
                        if (cat === '全部') {
                            selectedCategories = [...CATEGORIES];
                        } else {
                            if (selectedCategories.length === CATEGORIES.length) {
                                selectedCategories = [cat];
                            } else if (selectedCategories.includes(cat)) {
                                selectedCategories = selectedCategories.filter(c => c !== cat);
                                if (selectedCategories.length === 0) selectedCategories = [...CATEGORIES];
                            } else {
                                selectedCategories.push(cat);
                                if (selectedCategories.length === CATEGORIES.length)
