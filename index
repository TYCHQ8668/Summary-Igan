                    } else if (selectedYear !== '全部') {
                        const yearMonths = regularMonths.filter(m => extractYear(m) === selectedYear);
                        yearMonths.forEach(m => {
                            const md = v.months[m];
                            if (md) {
                                calcCats.forEach(cat => {
                                    const p = md[cat];
                                    if (p) totalVal += rankType === 'rm' ? (p.rm || 0) : (p.liter ||
                                        0);
                                });
                            }
                        });
                    } else {
                        regularMonths.forEach(m => {
                            const md = v.months[m];
                            if (md) {
                                calcCats.forEach(cat => {
                                    const p = md[cat];
                                    if (p) totalVal += rankType === 'rm' ? (p.rm || 0) : (p.liter ||
                                        0);
                                });
                            }
                        });
                    }
                    rankings.push({ vehicle: v.vehicle || '-', brand: v.brand || '-', type: v.type || '-', value: totalVal });
