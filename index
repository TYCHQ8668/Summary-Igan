<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fuel Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
        }
        body {
            background: #f0f4fa;
            padding: 24px;
            min-height: 100vh;
            display: flex;
            justify-content: center;
        }
        .dashboard {
            max-width: 1600px;
            width: 100%;
        }
        .header {
            background: white;
            border-radius: 20px;
            padding: 20px 28px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
            margin-bottom: 28px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            position: relative;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .header h1 {
            font-weight: 600;
            font-size: 1.7rem;
            color: #0b2b4a;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .header h1 i {
            color: #2a7de1;
        }
        .nav-menu-wrapper {
            position: relative;
        }
        .nav-menu-btn {
            background: #f0f4fa;
            border: 1.5px solid #dce3ec;
            padding: 8px 18px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.82rem;
            color: #1e3a5f;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .nav-menu-btn:hover {
            border-color: #2a7de1;
            background: #e8f0fa;
        }
        .nav-menu-btn i:last-child {
            font-size: 0.7rem;
            transition: transform 0.2s;
        }
        .nav-menu-btn.open i:last-child {
            transform: rotate(180deg);
        }
        .nav-dropdown {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            background: white;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            border: 1px solid #eef2f8;
            min-width: 200px;
            overflow: hidden;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-6px);
            transition: all 0.2s ease;
        }
        .nav-dropdown.show {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }
        .nav-dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 18px;
            cursor: pointer;
            font-weight: 500;
            font-size: 0.85rem;
            color: #1e3a5f;
            transition: background 0.15s;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }
        .nav-dropdown-item:hover {
            background: #f5f8fc;
        }
        .nav-dropdown-item.active {
            background: #e8f0fa;
            color: #2a7de1;
            font-weight: 600;
        }
        .nav-dropdown-item i {
            width: 20px;
            text-align: center;
            color: #2a7de1;
        }
        .nav-dropdown-item .nav-desc {
            font-size: 0.7rem;
            color: #8a9bb5;
            font-weight: 400;
        }
        .header-right {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }
        .header .badge {
            background: #e9eff8;
            padding: 6px 18px;
            border-radius: 40px;
            color: #1e4b7a;
            font-weight: 500;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .header .badge .cache-badge {
            font-size: 0.7rem;
            background: #d4e2f5;
            padding: 2px 12px;
            border-radius: 30px;
            color: #1a4b7a;
        }
        .year-selector {
            padding: 6px 16px 6px 14px;
            border-radius: 40px;
            border: 1.5px solid #dce3ec;
            background: white;
            font-weight: 500;
            font-size: 0.85rem;
            color: #1e3a5f;
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s;
            appearance: auto;
        }
        .year-selector:hover {
            border-color: #2a7de1;
        }
        .year-selector:focus {
            border-color: #2a7de1;
            box-shadow: 0 0 0 3px rgba(42, 125, 225, 0.15);
        }
        .btn-refresh {
            background: #2a7de1;
            color: white;
            border: none;
            padding: 8px 22px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background 0.2s, transform 0.1s;
            white-space: nowrap;
        }
        .btn-refresh:hover {
            background: #1a5fb0;
        }
        .btn-refresh:active {
            transform: scale(0.96);
        }
        .btn-refresh:disabled {
            background: #a0b8d0;
            cursor: not-allowed;
            transform: none;
        }
        .btn-export {
            background: #217346;
            color: white;
            border: none;
            padding: 8px 22px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background 0.2s, transform 0.1s;
            white-space: nowrap;
        }
        .btn-export:hover {
            background: #185a32;
        }
        .btn-export:active {
            transform: scale(0.96);
        }
        .btn-export:disabled {
            background: #a0b8a8;
            cursor: not-allowed;
            transform: none;
        }
        .btn-reset {
            background: #f0f4fa;
            color: #4a5a6e;
            border: 1.5px solid #dce3ec;
            padding: 8px 18px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-reset:hover {
            border-color: #e6a817;
            background: #fef9e7;
            color: #8a6e3b;
        }
        .btn-reset:active {
            transform: scale(0.96);
        }
        .toggle-group {
            display: flex;
            gap: 6px;
            align-items: center;
            background: #f0f4fa;
            padding: 4px;
            border-radius: 40px;
        }
        .toggle-btn {
            border: none;
            padding: 6px 18px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
            background: #dce3ec;
            color: #4a5a6e;
            opacity: 0.6;
        }
        .toggle-btn.active-rm {
            background: #1f5f9e;
            color: white;
            opacity: 1;
            box-shadow: 0 2px 6px rgba(31, 95, 158, 0.3);
        }
        .toggle-btn.active-liter {
            background: #1f8b6b;
            color: white;
            opacity: 1;
            box-shadow: 0 2px 6px rgba(31, 139, 107, 0.3);
        }
        .toggle-btn:active {
            transform: scale(0.94);
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }
        .stat-card {
            background: white;
            border-radius: 18px;
            padding: 16px 18px;
            border: 1px solid #eef2f8;
            transition: box-shadow 0.2s, border-color 0.2s;
        }
        .stat-card.clickable {
            cursor: pointer;
            user-select: none;
            position: relative;
        }
        .stat-card.clickable:hover {
            border-color: #2a7de1;
            box-shadow: 0 4px 16px rgba(42, 125, 225, 0.12);
        }
        .stat-card.clickable::after {
            content: "\f0d7";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            position: absolute;
            top: 10px;
            right: 14px;
            font-size: 0.7rem;
            color: #8a9bb5;
            opacity: 0.5;
        }
        .stat-card .label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #6f7e94;
            font-weight: 600;
        }
        .stat-card .value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0b2b4a;
            margin-top: 4px;
        }
        .stat-card .sub {
            font-size: 0.72rem;
            color: #3f5a78;
            margin-top: 2px;
        }
        .charts-row {
            display: flex;
            gap: 20px;
            margin-bottom: 28px;
        }
        .chart-panel {
            background: white;
            border-radius: 18px;
            padding: 20px;
            border: 1px solid #eef2f8;
            flex: 1;
            min-width: 0;
        }
        .chart-panel .panel-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: #1e3a5f;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .chart-panel .panel-title i {
            color: #2a7de1;
        }
        .chart-canvas-wrap {
            position: relative;
            width: 100%;
            height: 300px;
        }
        .chart-canvas-wrap canvas {
            width: 100% !important;
            height: 100% !important;
        }
        .rank-toggle-group {
            display: flex;
            gap: 4px;
            background: #f0f4fa;
            padding: 3px;
            border-radius: 30px;
            margin-left: auto;
            flex-wrap: wrap;
        }
        .rank-toggle-btn {
            border: none;
            padding: 4px 10px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.68rem;
            cursor: pointer;
            transition: all 0.2s;
            background: #dce3ec;
            color: #4a5a6e;
        }
        .rank-toggle-btn.active-rm {
            background: #1f5f9e;
            color: white;
        }
        .rank-toggle-btn.active-liter {
            background: #1f8b6b;
            color: white;
        }
        .rank-toggle-btn.active-warn {
            background: #e6a817;
            color: white;
        }
        .rank-toggle-btn.active-danger {
            background: #ef4444;
            color: white;
        }
        .pie-toggle-group {
            display: flex;
            gap: 4px;
            background: #f0f4fa;
            padding: 3px;
            border-radius: 30px;
            margin-left: auto;
        }
        .pie-toggle-btn {
            border: none;
            padding: 4px 14px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.72rem;
            cursor: pointer;
            transition: all 0.2s;
            background: #dce3ec;
            color: #4a5a6e;
        }
        .pie-toggle-btn.active-rm {
            background: #1f5f9e;
            color: white;
        }
        .pie-toggle-btn.active-liter {
            background: #1f8b6b;
            color: white;
        }
        .rank-list {
            list-style: none;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 4px;
        }
        .rank-list::-webkit-scrollbar {
            width: 6px;
        }
        .rank-list::-webkit-scrollbar-track {
            background: #eef2f8;
            border-radius: 3px;
        }
        .rank-list::-webkit-scrollbar-thumb {
            background: #c0d0e0;
            border-radius: 3px;
        }
        .rank-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 10px;
            margin-bottom: 4px;
            transition: background 0.15s;
        }
        .rank-item:hover {
            background: #f5f8fc;
        }
        .rank-num {
            font-weight: 700;
            font-size: 0.85rem;
            color: #8a9bb5;
            width: 24px;
            text-align: center;
            flex-shrink: 0;
        }
        .rank-item:nth-child(1) .rank-num {
            color: #e6a817;
            font-size: 1rem;
        }
        .rank-item:nth-child(2) .rank-num {
            color: #8a9bb5;
            font-size: 0.95rem;
        }
        .rank-item:nth-child(3) .rank-num {
            color: #b08a5c;
            font-size: 0.9rem;
        }
        .rank-info {
            flex: 1;
            min-width: 0;
        }
        .rank-name {
            font-weight: 600;
            font-size: 0.82rem;
            color: #1e3a5f;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .rank-detail {
            font-size: 0.7rem;
            color: #6f7e94;
        }
        .rank-value {
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
        }
        .rank-value.rm-color {
            color: #1f5f9e;
        }
        .rank-value.liter-color {
            color: #1f8b6b;
        }
        .rank-value.warn-color {
            color: #e6a817;
        }
        .rank-value.danger-color {
            color: #ef4444;
        }
        .rank-empty {
            text-align: center;
            padding: 40px 16px;
            color: #9aafc8;
            font-size: 0.85rem;
        }
        .table-container {
            background: white;
            border-radius: 20px;
            border: 1px solid #eef2f8;
            overflow: hidden;
            position: relative;
        }
        .table-scroll-wrapper {
            overflow: auto;
            max-height: 70vh;
            position: relative;
        }
        .table-scroll-wrapper::-webkit-scrollbar {
            width: 14px;
            height: 14px;
        }
        .table-scroll-wrapper::-webkit-scrollbar-track {
            background: #eef2f8;
        }
        .table-scroll-wrapper::-webkit-scrollbar-thumb {
            background: #c0d0e0;
            border-radius: 7px;
        }
        .table-scroll-wrapper::-webkit-scrollbar-thumb:hover {
            background: #a0b8d0;
        }
        .sticky-table {
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.82rem;
            width: 100%;
            min-width: max-content;
            table-layout: auto;
        }
        .sticky-table .col-fixed {
            position: sticky;
            left: 0;
            z-index: 1;
            background: white;
            min-width: 110px;
            width: 110px;
            box-shadow: 2px 0 0 0 #dce3ec;
        }
        .sticky-table .col-fixed:nth-child(1) {
            left: 0;
        }
        .sticky-table thead .col-fixed {
            z-index: 3;
            background: #f8faff;
        }
        .sticky-table .filter-row .col-fixed {
            z-index: 5;
            background: #f8faff;
        }
        .sticky-table thead tr:not(.filter-row) .col-fixed {
            z-index: 4;
        }
        .sticky-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f8faff;
            border-bottom: 2px solid #e2e9f2;
        }
        .sticky-table .filter-row td {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 8px 12px;
            background: #f8faff;
            border-bottom: 1px solid #eef2f8;
        }
        .sticky-table thead tr:not(.filter-row) th {
            top: 48px;
        }
        .sticky-table th,
        .sticky-table td {
            padding: 10px 12px;
            text-align: left;
            vertical-align: top;
            border-bottom: 1px solid #eef3f9;
            min-width: 110px;
        }
        .sticky-table .col-month {
            min-width: 180px;
            width: 180px;
        }
        .vehicle-cell {
            font-weight: 600;
            color: #0b2b4a;
        }
        .category-item {
            padding: 4px 8px;
            margin: 2px 0;
            background: #f8faff;
            border-radius: 8px;
            border: 1px solid #eef2f8;
            font-size: 0.78rem;
            line-height: 1.5;
        }
        .cat-name {
            font-weight: 600;
            color: #2c4b70;
            display: block;
            margin-bottom: 2px;
        }
        .val-row {
            display: flex;
            gap: 12px;
            font-size: 0.75rem;
        }
        .rm-value {
            color: #1f5f9e;
            font-weight: 600;
        }
        .liter-value {
            color: #1f8b6b;
            font-weight: 600;
        }
        .rm-value::before {
            content: "RM ";
            font-weight: 400;
            color: #5f7c9e;
        }
        .liter-value::after {
            content: " L";
            font-weight: 400;
            color: #5f7c9e;
        }
        .month-selector {
            padding: 4px 12px;
            border-radius: 30px;
            border: 1.5px solid #dce3ec;
            background: white;
            font-weight: 500;
            font-size: 0.78rem;
            color: #1e3a5f;
            cursor: pointer;
            outline: none;
            width: 130px;
        }
        .month-selector:hover {
            border-color: #2a7de1;
        }
        .month-selector:focus {
            border-color: #2a7de1;
            box-shadow: 0 0 0 3px rgba(42, 125, 225, 0.15);
        }
        .filter-label {
            font-weight: 600;
            font-size: 0.78rem;
            color: #1f3a5e;
            margin-right: 8px;
        }
        .category-filter-wrap {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-left: 12px;
            flex-wrap: wrap;
        }
        .category-filter-wrap .filter-label {
            margin-right: 0;
        }
        .category-chips {
            display: inline-flex;
            gap: 4px;
            flex-wrap: wrap;
        }
        .category-chip {
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
            cursor: pointer;
            border: 1.5px solid #dce3ec;
            background: white;
            color: #4a5a6e;
            transition: all 0.2s;
            white-space: nowrap;
            user-select: none;
        }
        .category-chip:hover {
            border-color: #2a7de1;
        }
        .category-chip.active {
            background: #2a7de1;
            color: white;
            border-color: #2a7de1;
        }
        .category-chip.all-chip {
            background: #f0f4fa;
            font-weight: 700;
        }
        .category-chip.all-chip.active {
            background: #1e3a5f;
            border-color: #1e3a5f;
            color: white;
        }
        .empty-state {
            text-align: center;
            padding: 48px 16px;
            color: #5f7390;
        }
        .empty-state i {
            font-size: 2.4rem;
            color: #cbd8e8;
            margin-bottom: 10px;
        }
        .footer {
            margin-top: 20px;
            font-size: 0.8rem;
            color: #5f7390;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            padding: 0 6px;
        }
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: #1e3a5f;
            color: white;
            padding: 12px 28px;
            border-radius: 40px;
            font-size: 0.9rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
            z-index: 999;
        }
        .toast.show {
            opacity: 1;
        }
        .sort-icon {
            font-size: 0.65rem;
            margin-left: 4px;
            opacity: 0.4;
            transition: opacity 0.2s;
            cursor: pointer;
        }
        .sort-icon.active {
            opacity: 1;
            color: #2a7de1;
        }
        .sortable-th {
            cursor: pointer;
            user-select: none;
            transition: background 0.15s;
        }
        .sortable-th:hover {
            background: #eef2fa !important;
        }
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.35);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }
        .modal-overlay.show {
            opacity: 1;
            pointer-events: auto;
        }
        .modal-dialog {
            background: white;
            border-radius: 18px;
            width: 520px;
            max-width: 92vw;
            max-height: 75vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 16px 48px rgba(0, 0, 0, 0.18);
            transform: translateY(20px);
            transition: transform 0.25s ease;
        }
        .modal-overlay.show .modal-dialog {
            transform: translateY(0);
        }
        .modal-header {
            padding: 18px 22px;
            border-bottom: 1px solid #eef2f8;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .modal-header h3 {
            font-size: 1rem;
            font-weight: 700;
            color: #1e3a5f;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .modal-header h3 i {
            color: #2a7de1;
        }
        .modal-close {
            border: none;
            background: #f0f4fa;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 0.9rem;
            color: #5f7390;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .modal-close:hover {
            background: #dce3ec;
        }
        .modal-search {
            padding: 12px 22px;
            border-bottom: 1px solid #eef2f8;
        }
        .modal-search input {
            width: 100%;
            padding: 9px 14px;
            border-radius: 30px;
            border: 1.5px solid #dce3ec;
            font-size: 0.82rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .modal-search input:focus {
            border-color: #2a7de1;
            box-shadow: 0 0 0 3px rgba(42, 125, 225, 0.1);
        }
        .modal-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px 22px 16px;
        }
        .modal-list::-webkit-scrollbar {
            width: 6px;
        }
        .modal-list::-webkit-scrollbar-track {
