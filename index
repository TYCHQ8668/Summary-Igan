            function fmt(num) {
                const n = Number(num);
                return Number.isFinite(n) ? n.toFixed(2) : '0.00';
            }

            function fmtComma(num) {
                const parts = fmt(num).split('.');
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                return parts.join('.');
            }

            function getCache() {
                try {
                    const raw = localStorage.getItem(CACHE_KEY);
                    const time = localStorage.getItem(CACHE_TIME_KEY);
                    return raw && time ? { data: JSON.parse(raw), timestamp: +time } : null;
                } catch { return null; }
            }

            function setCache(data) {
                try { localStorage.setItem(CACHE_KEY, JSON.stringify(data));
                    localStorage.setItem(CACHE_TIME_KEY, String(Date.now())); } catch {}
            }

            function isCacheValid(cache) { return cache && Date.now() - cache.timestamp < CACHE_TTL; }

            function formatCacheTime(ts) { return new Date(ts).toLocaleString('zh-CN', { hour12: false }); }

            function showToast(msg, icon = 'fa-check-circle') {
                toastMsg.textContent = msg;
                toast.querySelector('i').className = `fa-solid ${icon}`;
                toast.classList.add('show');
                clearTimeout(toast._t);
                toast._t = setTimeout(() => toast.classList.remove('show'), 3000);
            }

            function updateCacheBadge(status, ts) { cacheStatus.textContent = ts ? `${status} · ${formatCacheTime(ts)}` :
                    status; }

            function setLoading(loading) {
                if (loading) { refreshBtn.disabled = true;
                    refreshBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> 更新中...'; } else { refreshBtn
                        .disabled = false;
                    refreshBtn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> 更新数据'; }
            }

            function isExcludedMonth(name) { return EXCLUDED_MONTH_PREFIXES.some(p => name.startsWith(p)); }

            function extractYear(str) {
                if (!str) return '';
                if (str.includes('-')) { const last = str.split('-').pop(); return /^\d{2}$/.test(last) ? '20' + last :
                    last; }
                const m4 = str.match(/\d{4}/);
                if (m4) return m4[0];
                const m2 = str.match(/\d{2}/);
                if (m2) return '20' + m2[0];
                return str;
            }

            function extractMonthAbbr(str) { return str.includes('-') ? str.split('-')[0] : str; }

            function monthSortKey(abbr) {
                const order = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                const idx = order.indexOf(abbr);
                return idx >= 0 ? idx : 99;
            }

            function fetchFromAPI() {
                return fetch(API_URL).then(res => { if (!res.ok) throw new Error(`HTTP ${res.status}`); return res
                .json(); });
            }

            function fetchData(force = false) {
                const cache = getCache();
                if (force) {
                    updateCacheBadge('更新中...');
                    return fetchFromAPI().then(d => { setCache(d);
                            updateCacheBadge('已缓存', Date.now());
                            showToast('数据已更新'); return d; })
                        .catch(err => {
                            if (cache) { updateCacheBadge('过期缓存', cache.timestamp);
                                showToast('网络异常，使用缓存数据', 'fa-triangle-exclamation'); return cache
                                .data; }
                            throw err;
                        });
                }
                if (cache && isCacheValid(cache)) { updateCacheBadge('缓存', cache.timestamp); return Promise.resolve(cache
                        .data); }
                updateCacheBadge('更新中...');
                return fetchFromAPI().then(d => { setCache(d);
                        updateCacheBadge('已缓存', Date.now()); return d; })
                    .catch(err => { if (cache) { updateCacheBadge('过期缓存', cache.timestamp);
                            showToast('网络异常，使用缓存数据', 'fa-triangle-exclamation'); return cache.data; } throw err; });
            }

            function getFixedColValue(vehicle, col) {
                const map = { vehicle: 'vehicle', brand: 'brand', type: 'type', fuel: 'fuel' };
                const key = map[col];
                return (vehicle[key] || '').toString().toLowerCase();
            }

            function getTypeCombo(vehicle) {
                const brand = vehicle.brand || '-';
                const type = vehicle.type || '-';
                return brand + ' - ' + type;
            }

            function getFuelList(vehicles) {
                return [...new Set(vehicles.map(v => v.fuel || '-'))].sort();
            }

            function getFilteredVehicles(allVehicles) {
                let result = [...allVehicles];
                if (selectedVehicles.length > 0) {
                    result = result.filter(v => selectedVehicles.includes(v.vehicle));
                }
                if (selectedTypes.length > 0) {
                    result = result.filter(v => selectedTypes.includes(getTypeCombo(v)));
                }
                if (selectedFuels.length > 0) {
                    result = result.filter(v => selectedFuels.includes(v.fuel || '-'));
                }
                return result;
            }

            function sortVehicles(vehicles) {
                if (sortState.direction === 0 || !sortState.column) return [...vehicles];
                const col = sortState.column;
                const dir = sortState.direction;
                const sorted = [...vehicles];
                sorted.sort((a, b) => {
                    const valA = getFixedColValue(a, col);
                    const valB = getFixedColValue(b, col);
                    if (valA < valB) return -1 * dir;
                    if (valA > valB) return 1 * dir;
                    return 0;
                });
                return sorted;
            }

            function getSortIcon(colKey) {
                if (sortState.column !== colKey || sortState.direction === 0) {
                    return '<i class="fa-solid fa-sort sort-icon"></i>';
                }
                const icon = sortState.direction === 1 ? 'fa-sort-up' : 'fa-sort-down';
                return `<i class="fa-solid ${icon} sort-icon active"></i>`;
            }

            function handleSortClick(colKey) {
                if (sortState.column === colKey) {
                    if (sortState.direction === 1) sortState.direction = -1;
                    else if (sortState.direction === -1) { sortState.direction = 0;
                        sortState.column = null; } else sortState.direction = 1;
                } else {
                    sortState.column = colKey;
                    sortState.direction = 1;
                }
                cachedData && render(cachedData);
            }

            function getChartMonths(allRegularMonths) {
                const now = new Date();
                const thisYear = String(now.getFullYear());
                const thisMonthAbbr = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][
                    now.getMonth()
                ];
                if (selectedYear === '全部' || selectedYear === thisYear) {
                    const sorted = [...allRegularMonths].sort((a, b) => {
                        const ya = extractYear(a),
                            yb = extractYear(b);
                        if (ya !== yb) return ya.localeCompare(yb);
                        return monthSortKey(extractMonthAbbr(a)) - monthSortKey(extractMonthAbbr(b));
                    });
                    const thisMonthStr = thisMonthAbbr + '-' + thisYear.slice(2);
                    let endIdx = sorted.findIndex(m => m === thisMonthStr);
                    if (endIdx < 0) {
                        for (let i = sorted.length - 1; i >= 0; i--) {
                            const y = extractYear(sorted[i]);
                            const mAbbr = extractMonthAbbr(sorted[i]);
                            if (y < thisYear || (y === thisYear && monthSortKey(mAbbr) <= monthSortKey(thisMonthAbbr))) {
                                endIdx = i;
                                break;
                            }
                        }
                    }
                    if (endIdx < 0) endIdx = sorted.length - 1;
                    const startIdx = Math.max(0, endIdx - 11);
                    return sorted.slice(startIdx, endIdx + 1);
                } else {
                    const yearMonths = allRegularMonths.filter(m => extractYear(m) === selectedYear);
                    return yearMonths.sort((a, b) => monthSortKey(extractMonthAbbr(a)) - monthSortKey(extractMonthAbbr(b)));
                }
            }

