                monthAbbrs.forEach(m => head += `<option value="${m}">${m}</option>`);
                head += `</select><span class="category-filter-wrap"><span class="filter-label"><i class="fa-solid fa-gas-pump"></i> 类别</span><span class="category-chips" id="categoryChipsWrap"></span></span></td>`;
                head +=
                    `<td colspan="${display.length+2}" style="background:#f8faff;"><span style="font-size:.75rem;color:#5e7390;"><i class="fa-solid fa-filter"></i> 共 ${filtered.length} 个月份${selectedMonth==='全部'&&display.length>filtered.length?` + ${display.length-filtered.length} 个汇总`:''}</span></td></tr>`;
                head += `<tr>`;
