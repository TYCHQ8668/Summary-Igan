            function getSummaryFilteredVehicles(allVehicles) {
                let result = [...allVehicles];
                if (summaryVehicles.length > 0) {
                    result = result.filter(v => summaryVehicles.includes(v.vehicle));
                }
                if (summaryTypes.length > 0) {
                    result = result.filter(v => summaryTypes.includes(getTypeCombo(v)));
                }
                if (summaryFuels.length > 0) {
                    result = result.filter(v => summaryFuels.includes(v.fuel || '-'));
                }
                return result;
            }

            function getSummaryValue(v, month, cat) {
                const md = v.months[month];
                if (!md) return 0;
                const val = md[cat];
                return val || 0;
            }

            function getSummaryExpense(v, month) {
                let total = 0;
                EXPENSE_CATEGORIES.forEach(cat => {
                    if (summaryCategories.includes(cat)) {
                        total += getSummaryValue(v, month, cat);
                    }
                });
                return total;
            }

            function getSummaryRevenue(v, month) {
                return summaryCategories.includes('Revenue') ? getSummaryValue(v, month, 'Revenue') : 0;
            }

            function getSummaryProfit(v, month) {
                return summaryCategories.includes('Profit') ? getSummaryValue(v, month, 'Profit') : 0;
            }

